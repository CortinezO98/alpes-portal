DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8010
DJANGO_PORT=8010

# Local directo (python manage.py ...): SQLite por defecto.
# Docker Compose sobrescribe este valor a postgresql.
DATABASE_ENGINE=sqlite

POSTGRES_DB=alpes
POSTGRES_USER=alpes
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8010
DJANGO_PORT=8010

POSTGRES_DB=alpes
POSTGRES_USER=alpes
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Opcional. Si ambos valores están vacíos, Facebook Login permanece deshabilitado.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Opcional. Si ambos valores están vacíos, Google Login permanece deshabilitado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo SMTP. En desarrollo, si EMAIL_HOST está vacío, los correos se imprimen en consola.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=ALPES <no-reply@example.com>
SERVER_EMAIL=ALPES <no-reply@example.com>
